# Supabase Configuration
# Replace these with your actual Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# College Email Domain Restriction
# Only users with emails ending in @<domain> are allowed to sign up (e.g. msrit.edu)
VITE_ALLOWED_EMAIL_DOMAIN=msrit.edu
